# ==============================================================================
# LONE WOLF DUMPSTERS - PRODUCTION ENVIRONMENT VARIABLES (VERCEL)
# ==============================================================================

# 1. Upstash Redis (Serverless Database & Lead Pipeline)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 2. Owner Studio Admin Authentication
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_SESSION_SECRET=your_high_entropy_session_signing_secret_here

# 3. Vercel Blob (Durable Image Upload Storage)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_token_here

# 4. Email Dispatch Service (Optional / Future Resend integration)
RESEND_API_KEY=re_your_resend_api_key_here
